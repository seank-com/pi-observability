{
  "name": "@seank/pi-observability",
  "version": "0.1.0",
  "description": "Pi tool intent auditing and provider egress redaction",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package"],
  "repository": {"type": "git", "url": "https://github.com/seank-com/pi-observability.git"},
  "files": ["dist", "README.md", "LICENSE", "docs"],
  "pi": {"extensions": ["./dist/index.js"]},
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./contract": {"types": "./dist/contract.d.ts", "import": "./dist/contract.js"},
    "./intent": {"types": "./dist/intent.d.ts", "import": "./dist/intent.js"},
    "./redaction": {"types": "./dist/egress-redaction.d.ts", "import": "./dist/egress-redaction.js"}
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.ts",
    "build": "node scripts/build.ts",
    "test:package": "npm run build && node --test tests/package.test.ts"
  },
  "peerDependencies": {"@earendil-works/pi-coding-agent": "*"},
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.3.1",
    "typescript": "5.9.2"
  },
  "engines": {"node": ">=24.14.1"}
}
